FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi uvicorn pandas numpy scikit-learn joblib xgboost
COPY core ./core
COPY api ./api
COPY models ./models
ENV MODEL_PATH=models/fraud_model.joblib
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
